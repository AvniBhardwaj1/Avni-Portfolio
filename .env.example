# Server-side variables (set these in the Vercel project settings)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=avni_portfolio
STATS_TOKEN=replace-with-a-random-secret
CRON_SECRET=replace-with-a-different-random-secret
SITE_URL=https://your-portfolio.vercel.app
CORS_ORIGINS=https://your-portfolio.vercel.app

# Choose mock or a provider: groq, gemini, openrouter, anthropic, openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=512
LLM_FALLBACK=mock

# Choose resend or smtp when enabling weekly digest email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Avni Bhardwaj Portfolio
EMAIL_REPLY_TO=
DIGEST_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
